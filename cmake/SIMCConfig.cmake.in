# SIMCConfig.cmake — the SIMC++ CMake package (task P15.3).
#   find_package(SIMC 2.0 REQUIRED)
#   add_executable(my_simc main.cpp MyPlugin.cpp)
#   target_link_libraries(my_simc PRIVATE SIMC::simc)
# SIMC::simc links everything a complete run needs (headers in <prefix>/include). SIMC_DATA_DIR = the installed data
# (COSY maps, spectral functions, model tables, field map), the default data directory of the programs linked with it.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(nlohmann_json 3.9)
find_dependency(ROOT 6.40 COMPONENTS Core Tree Hist RIO)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/SIMCTargets.cmake")
set(SIMC_DATA_DIR "${PACKAGE_PREFIX_DIR}/share/simc/data")
# P15.4 (D-069): programs linked with SIMC::simc take this package's data directory as their default data root
# (include/simc/core/DataPath.h): one small interface source registers it at start-up (env SIMC_DATA_DIR still wins).
if(NOT TARGET SIMC::simc_installed_data_root)
    add_library(SIMC::simc_installed_data_root INTERFACE IMPORTED)
    set_target_properties(SIMC::simc_installed_data_root PROPERTIES
        INTERFACE_SOURCES "${PACKAGE_PREFIX_DIR}/share/simc/cmake/SimcInstalledDataRoot.cpp"
        INTERFACE_COMPILE_DEFINITIONS "SIMC_INSTALLED_DATA_DIR=\"${SIMC_DATA_DIR}\"")
    set_property(TARGET SIMC::simc APPEND PROPERTY INTERFACE_LINK_LIBRARIES SIMC::simc_installed_data_root)
endif()
check_required_components(SIMC)
