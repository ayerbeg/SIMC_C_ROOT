# tests/l1/rho.cmake — task P13.1: the exclusive rho0 kernels (rho_physics.f:peerho, generate_rho.f, rho_decay.f) and the
# IPhysicsModel "rho". Included (OPTIONAL) by tests/l1/CMakeLists.txt.
# Now: kinematic identities, RNG order/counts, failure paths, the D-031 switches (unit), and the rho set-up/plug-in
# checks; bitwise L1 against the P13.F1 tables (reference/functions/rho/, fortran_compat, tolerance 0).
add_executable(test_l1_rho test_l1_rho.cpp)
target_link_libraries(test_l1_rho PRIVATE simcfw_l1runner ${SIMC_DRIVER_LIBS})
target_compile_options(test_l1_rho PRIVATE -Wall -Wextra -pedantic)

add_test(NAME rho_sanity COMMAND test_l1_rho sanity)
add_test(NAME rho_setup COMMAND test_l1_rho setup ${SIMC_REFERENCE_DIR}/runs/pion_h_k1_rad_dec1_A/pion_h_k1_rad_dec1_A.inp)
set_tests_properties(rho_sanity rho_setup PROPERTIES SKIP_RETURN_CODE 77 LABELS unit)
# D-057 F3, F6, F9, F20, F21 (FORTRAN-BUG, corrected by default): both modes on the kernels
add_test(NAME fortran_diff_D057_rho_kernels COMMAND test_l1_rho fortran_diff)
set_tests_properties(fortran_diff_D057_rho_kernels PROPERTIES LABELS "fortran_diff;unit")

# Bitwise L1 against the P13.F1 kernel tables (fortran_compat, tolerance 0)
set(_rfn ${SIMC_REFERENCE_DIR}/functions/rho)
set(_rinp ${_rfn}/rho_state/inp)
set(_rsp ${CMAKE_SOURCE_DIR}/data/spectral)
add_test(NAME l1_peerho COMMAND test_l1_rho peerho ${_rfn}/peerho ${_rinp} ${_rsp} 0)
add_test(NAME l1_generate_rho_fixedrng COMMAND test_l1_rho generate_rho ${_rfn}/generate_rho_fixedrng ${_rinp} ${_rsp} 0)
add_test(NAME l1_rho_decay_fixedrng COMMAND test_l1_rho rho_decay ${_rfn}/rho_decay_fixedrng ${_rinp} ${_rsp} 0)
set_tests_properties(l1_peerho l1_generate_rho_fixedrng l1_rho_decay_fixedrng PROPERTIES SKIP_RETURN_CODE 77 LABELS l1)
# the RANLUX port (IRandom "ranlux", P13.2) against the captured RANLUX stream (tries 1..3000 are fully logged)
add_test(NAME l1_ranlux_stream_rho_h COMMAND test_l1_rho ranlux_stream ${_rfn}/event_capture_rho/cap_h 12345 3000)
set_tests_properties(l1_ranlux_stream_rho_h PROPERTIES SKIP_RETURN_CODE 77 LABELS l1)

# task P13.2: the rho reaction (reactions::RhoProduction + the "rho" model) against the P13.F1 event tables, fortran_compat,
# BITWISE (tolerance 0); runners of the pion/kaon/delta/semi tables with `rho`.
set(_rpd ${CMAKE_SOURCE_DIR}/data/pion)
add_test(NAME l1_rho_state COMMAND test_l1_pion_event pion_state ${_rfn}/rho_state ${_rinp} ${_rsp} ${_rpd} 0 rho)
add_test(NAME l1_generate_rho_branch_fixedrng
         COMMAND test_l1_pion_event generate ${_rfn}/generate_rho_branch_fixedrng ${_rinp} ${_rsp} ${_rpd} 0 rho)
add_test(NAME l1_complete_ev_rho COMMAND test_l1_pion_event complete_ev ${_rfn}/complete_ev_rho ${_rinp} ${_rsp} ${_rpd} 0 rho)
add_test(NAME l1_complete_recon_ev_rho
         COMMAND test_l1_pion_event complete_recon_ev ${_rfn}/complete_recon_ev_rho ${_rinp} ${_rsp} ${_rpd} 0 rho)
add_test(NAME l1_complete_main_rho COMMAND test_l1_pion_event complete_main ${_rfn}/complete_main_rho ${_rinp} ${_rsp} ${_rpd} 0 rho)
set(_rho_l1 l1_rho_state l1_generate_rho_branch_fixedrng l1_complete_ev_rho l1_complete_recon_ev_rho l1_complete_main_rho)
# the two P13.F1 captures (H/D(e,e'pi+)[rho] K1 rad, HMS e- + SHMS pi; two-pass format): every full-logged generate /
# complete_ev / complete_recon_ev / complete_main call, every full-logged montecarlo call, and the full SimcRun with the
# whole RANLUX stream regenerated by IRandom "ranlux" (every try, 59-column tree, .bin, bookkeeping, .hist/.geni/.gen)
foreach(_c "h;p13f1_rh_k1_rad_cap" "d;p13f1_rd_k1_rad_cap")
    list(GET _c 0 _tag)
    list(GET _c 1 _run)
    add_test(NAME l1_replay_event_capture_rho_${_tag}
             COMMAND test_l1_pion_event capture ${_rfn}/event_capture_rho/cap_${_tag}
                     ${SIMC_REFERENCE_DIR}/runs/${_run}/${_run}.inp ${_rsp} ${_rpd} 0 rho)
    set(_out ${CMAKE_CURRENT_BINARY_DIR}/simcrun_replay_rho_${_tag})
    file(MAKE_DIRECTORY ${_out})
    add_test(NAME l1_simcrun_replay_rho_${_tag} COMMAND test_l1_simcrun replay_ranlux
        ${_rfn}/event_capture_rho/cap_${_tag} ${SIMC_REFERENCE_DIR}/runs/${_run} ${_tag} ${_out} ${_run})
    add_test(NAME l1_montecarlo_replay_rho_${_tag} COMMAND test_l1_driver replay
        ${_rfn}/event_capture_rho/cap_${_tag} ${SIMC_REFERENCE_DIR}/runs/${_run} ${_tag} ${_rsp} ${_run})
    list(APPEND _rho_l1 l1_replay_event_capture_rho_${_tag} l1_simcrun_replay_rho_${_tag} l1_montecarlo_replay_rho_${_tag})
endforeach()
set_tests_properties(${_rho_l1} PROPERTIES SKIP_RETURN_CODE 77 LABELS l1 TIMEOUT 1800)
foreach(_tag h d)
    set_tests_properties(l1_replay_event_capture_rho_${_tag} l1_simcrun_replay_rho_${_tag}
        l1_montecarlo_replay_rho_${_tag} PROPERTIES LABELS "l1;replay")
endforeach()
# D-057 F1 (stale hadron angle) and F2 (rho_decay after a failed generate_rad): both modes on the H capture tries
add_test(NAME fortran_diff_D057_F1_F2_rho
         COMMAND test_l1_pion_event fortran_diff_rho ${_rfn}/generate_rho_branch_fixedrng ${_rinp} ${_rsp} ${_rpd} 0 rho)
set_tests_properties(fortran_diff_D057_F1_F2_rho PROPERTIES SKIP_RETURN_CODE 77 LABELS "fortran_diff;l1")
# D-057 F15 (.hist title for D/3He) and F18 (P-arm report quantities from the decay pion): short runs in both modes
set(_rfd ${CMAKE_CURRENT_BINARY_DIR}/fortran_diff_rho_report)
file(MAKE_DIRECTORY ${_rfd})
add_test(NAME fortran_diff_D057_F15_F18_rho
         COMMAND test_l1_rho fortran_diff_report ${SIMC_REFERENCE_DIR}/runs/p13f1_rd_k1_rad_cap/p13f1_rd_k1_rad_cap.inp ${_rfd})
set_tests_properties(fortran_diff_D057_F15_F18_rho PROPERTIES SKIP_RETURN_CODE 77 LABELS "fortran_diff;l1")
