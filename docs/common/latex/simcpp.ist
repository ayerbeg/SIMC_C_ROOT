% docs/common/latex/simcpp.ist - makeindex style of the SIMC++ books (used as makeindex -s simcpp.ist <book>.idx
% between the first and second xelatex pass; tools/build_docs_pdf.py does it).
headings_flag 0
heading_prefix "\\simcindexgroup{"
heading_suffix "}\n"
symhead_positive "Symbols"
numhead_positive "Numbers"
delim_0 "\\dotfill "
delim_1 "\\dotfill "
delim_2 "\\dotfill "
