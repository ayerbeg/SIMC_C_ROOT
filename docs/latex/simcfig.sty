% docs/latex/simcfig.sty — the SIMC++ palette (from the logo docs/figures/simcpp_logo.png) and the TikZ styles shared
% by the books (simcpp.cls) and the figures (docs/latex/figures/*.tex) (task P15.D5).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{simcfig}[2026/11/16 SIMC++ palette and TikZ styles]
\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,shapes.misc,fit,backgrounds,
  decorations.pathreplacing,shadows}
% ---- palette -------------------------------------------------------------------------------------------------------
\definecolor{simcnavy}{HTML}{0B1F3F}   % text, headings (the "SIMC" of the logo)
\definecolor{simcblue}{HTML}{1565C0}   % primary accent (the "++", the beam, the upper magnet)
\definecolor{simcgreen}{HTML}{2E8B2E}  % secondary accent, sparingly (lower magnet: tips, "pass")
\definecolor{simcred}{HTML}{D32F2F}    % secondary accent, sparingly (red track: warnings, "stop")
\definecolor{simcgray}{HTML}{5B6573}   % captions, labels, rules
\definecolor{simcamber}{HTML}{F2B01E}  % the starburst at the target (figures only)
\colorlet{simcpale}{simcblue!7}
\colorlet{simcrule}{simcgray!35}
% ---- TikZ styles ---------------------------------------------------------------------------------------------------
\tikzset{
  simc/base/.style={font=\sffamily\small, text=simcnavy, align=center, inner sep=4pt},
  simc/box/.style={simc/base, draw=simcnavy!70, fill=white, rounded corners=2pt, line width=0.7pt,
    minimum height=8mm},
  simc/stage/.style={simc/base, draw=simcblue, fill=simcblue!8, rounded corners=2pt, line width=0.8pt,
    minimum height=7mm},
  simc/key/.style={simc/base, draw=simcnavy, fill=simcnavy, text=white, rounded corners=2pt, font=\sffamily\small\bfseries,
    minimum height=8mm},
  simc/file/.style={simc/base, draw=simcgray!80, fill=simcgray!7, minimum height=6.5mm, font=\ttfamily\footnotesize,
    rounded corners=1pt, line width=0.6pt},
  simc/ok/.style={simc/base, draw=simcgreen, fill=simcgreen!8, rounded corners=2pt, line width=0.8pt},
  simc/stop/.style={simc/base, draw=simcred, fill=simcred!7, rounded corners=2pt, line width=0.8pt},
  simc/note/.style={font=\sffamily\scriptsize, text=simcgray, align=left, inner sep=2pt},
  simc/title/.style={font=\sffamily\bfseries\small, text=simcnavy},
  simc/group/.style={draw=simcgray!70, dashed, rounded corners=4pt, inner sep=6pt, line width=0.6pt},
  simc/panel/.style={draw=none, fill=simcpale, rounded corners=4pt, inner sep=6pt},
  simc/arrow/.style={-{Stealth[length=2.4mm,width=1.8mm]}, line width=0.9pt, draw=simcnavy!80},
  simc/flow/.style={-{Stealth[length=2.4mm,width=1.8mm]}, line width=1.1pt, draw=simcblue},
  simc/fail/.style={-{Stealth[length=2mm]}, line width=0.8pt, draw=simcred, dashed},
  simc/code/.style={font=\ttfamily\footnotesize},
}
\endinput
