; legacy_names.inp - the input of h_elastic_rad.inp written with the old '.' structure names (targ.A, spec.e.P, ...).
; SIMC++ ignores these names (chapter 4.1.3 of the user manual): this file is an example of what NOT to do.
begin parm experiment
  ngen = 200000			;  POS: # of successes; NEG: # of tries
  EXPER.charge = 1.0		;  total charge (mC)
  doing_phsp = 0		;  (ONE = TRUE)
  doing_kaon = 0		;  (ONE = TRUE)
  doing_pion = 0		;  (ONE = TRUE)
  which_pion = 0
  which_kaon = 0
  doing_delta = 0
  doing_semi = 0
  doing_rho = 0
  doing_pizero = 0
  doing_hplus = 1
  doing_decay = 0		;  1=decay ON, 0=decay OFF.
  ctau = 780.4			;  decay length (cm)
  random_seed = 12345		;  random-number seed
  use_benhar_sf = 0
end parm experiment

begin parm kinematics_main
  Ebeam = 10600.0		;  (MeV)
  dEbeam = 0.0			;  beam energy variation (%)
  electron_arm = 5		;  5=SHMS
  hadron_arm = 1		;  1=HMS
  use_first_cer = 0
  spec.e.P = 8360.989		;  e arm central momentum (MeV/c) - SHMS, elastic
  spec.e.theta = 12.5		;  e arm angle (deg)
  spec.p.P = 3035.585		;  p arm central momentum (MeV/c) - HMS, elastic
  spec.p.theta = 36.594		;  p arm angle (deg), elastic
end parm kinematics_main

begin parm target
  targ.A = 1.0
  targ.Z = 1.0
  targ.mass_amu = 1.007276
  targ.mrec_amu = 0.0
  targ.rho = 0.0723		;  g/cm3
  targ.thick = 100.0		;  mg/cm2
  targ.angle = 0.0
  targ.abundancy = 100.0
  targ.can = 1			;  beer can
end parm target

begin parm debug
  debug(1) = 0
  debug(2) = 0
  debug(3) = 0
  debug(4) = 0
  debug(5) = 0
  debug(6) = 0
end parm debug

begin parm e_arm_accept
  SPedge.e.delta.min = -10.0
  SPedge.e.delta.max =  22.0
  SPedge.e.yptar.min = -60.0
  SPedge.e.yptar.max =  60.0
  SPedge.e.xptar.min = -80.0
  SPedge.e.xptar.max =  80.0
end parm e_arm_accept

begin parm p_arm_accept
  SPedge.p.delta.min = -10.0
  SPedge.p.delta.max =  10.0
  SPedge.p.yptar.min = -60.0
  SPedge.p.yptar.max =  60.0
  SPedge.p.xptar.min = -80.0
  SPedge.p.xptar.max =  80.0
end parm p_arm_accept

begin parm beamandtargetinfo
  gen.xwid = 0.008868		;  beam width 1 sigma (cm)
  gen.ywid = 0.004235		;  beam width 1 sigma (cm)
  targ.fr_pattern = 1		;  1=square (bedpost)
  targ.fr1 = 0.1		;  cm
  targ.fr2 = 0.1		;  cm
  targ.xoffset = 0.0
  targ.yoffset = 0.0
  targ.zoffset = 0.0
end parm beamandtargetinfo

begin parm spect_offset
  spec.e.offset.x = 0.0
  spec.e.offset.y = 0.0
  spec.e.offset.z = 0.0
  spec.e.offset.xptar = 0.0
  spec.e.offset.yptar = 0.0
  spec.p.offset.x = 0.0
  spec.p.offset.y = 0.0
  spec.p.offset.z = 0.0
  spec.p.offset.xptar = 0.0
  spec.p.offset.yptar = 0.0
end parm spect_offset

begin parm simulate
  hard_cuts = 0
  using_rad = 1
  use_expon = 0
  one_tail = 0
  intcor_mode = 1
  spect_mode = 0
  cuts.Em.min = 0.0
  cuts.Em.max = 200.0
  using_Eloss = 1
  correct_Eloss = 1
  correct_raster = 1
  mc_smear = 1		;  target+hut multiple scattering AND wire-chamber smearing
  deForest_flag = 0
  rad_flag = 0
  extrad_flag = 2
  lambda(1) = 0.0
  lambda(2) = 0.0
  lambda(3) = 0.0
  Nntu = 1
  using_Coulomb = 1
  dE_edge_test = 0.0
  use_offshell_rad = 1
  Egamma_gen_max = 0.0
  using_HMScoll = 0
  using_SHMScoll = 0
  using_tgt_field = 0
end parm simulate
